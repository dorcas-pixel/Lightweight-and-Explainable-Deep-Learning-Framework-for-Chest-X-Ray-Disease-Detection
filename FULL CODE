Chest X-ray disease detection: training, ablation, confusion matrices,
and 95% bootstrap confidence intervals.
Classes: Normal, Pneumonia, Tuberculosis
Target split:
  Normal:       4667 train / 274 val / 584 test
  Pneumonia:    3633 train / 213 val / 427 test
  Tuberculosis: 3573 train / 207 val / 417 test
Image size: 224x224
Training augmentation: rotation, horizontal flip, zoom, translation
Backbone: EfficientNet-B0
Attention: CBAM
Optimizer: Adam, lr=1e-4
Batch size: 32
Epochs: 50
Loss: categorical cross-entropy
Explainability: Grad-CAM
SSL: contrastive pretraining

IMPORTANT:
1. Set SOURCE_DIR to your image dataset root.
2. The source must contain Normal, Pneumonia and Tuberculosis folders
   with exactly the manuscript totals.
3. The script does NOT use the test set for training.
4. Grad-CAM is an explainability method; it is not treated as a
   predictive component in the ablation comparison.


import os
import random
import shutil
from pathlib import Path

import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers

import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    classification_report,
    confusion_matrix,
)

# ============================================================
#  CONFIGURATION
# ============================================================

SOURCE_DIR = Path("DATASET_ROOT")       # <-- CHANGE THIS
OUTPUT_DIR = Path("CXR_SPLIT")
RESULTS_DIR = Path("CXR_RESULTS")

CLASSES = ["Normal", "Pneumonia", "Tuberculosis"]
NUM_CLASSES = len(CLASSES)

TARGET_COUNTS = {
    "Normal":       {"train": 4667, "val": 274, "test": 584},
    "Pneumonia":    {"train": 3633, "val": 213, "test": 427},
    "Tuberculosis": {"train": 3573, "val": 207, "test": 417},
}

IMG_SIZE = (224, 224)
BATCH_SIZE = 32
EPOCHS = 50
SSL_EPOCHS = 10
LEARNING_RATE = 1e-4
SEED = 42
BOOTSTRAP_N = 2000
RUN_ABLATIONS = True

# For quick testing, set EPOCHS lower. For the manuscript experiment,
# use 50 epochs as specified above.
random.seed(SEED)
np.random.seed(SEED)
tf.random.set_seed(SEED)

AUTOTUNE = tf.data.AUTOTUNE
VALID_EXTENSIONS = {".jpg", ".jpeg", ".png", ".bmp", ".tif", ".tiff"}

RESULTS_DIR.mkdir(parents=True, exist_ok=True)

# ============================================================
# DATA SPLITTING
# ============================================================

def list_images(folder):
    return sorted(
        p for p in folder.rglob("*")
        if p.is_file() and p.suffix.lower() in VALID_EXTENSIONS
    )


def make_exact_split():
    if not SOURCE_DIR.exists():
        raise FileNotFoundError(
            f"Dataset folder not found: {SOURCE_DIR}\n"
            "Set SOURCE_DIR to the directory containing the class folders."
        )

    if OUTPUT_DIR.exists():
        shutil.rmtree(OUTPUT_DIR)

    for split in ["train", "val", "test"]:
        for cls in CLASSES:
            (OUTPUT_DIR / split / cls).mkdir(parents=True, exist_ok=True)

    summary = {}

    for cls in CLASSES:
        source_class = SOURCE_DIR / cls
        images = list_images(source_class)

        required = sum(TARGET_COUNTS[cls].values())
        if len(images) != required:
            raise ValueError(
                f"{cls}: found {len(images)} images, but manuscript requires "
                f"{required} images."
            )

        rng = random.Random(SEED)
        rng.shuffle(images)

        n_train = TARGET_COUNTS[cls]["train"]
        n_val = TARGET_COUNTS[cls]["val"]

        split_files = {
            "train": images[:n_train],
            "val": images[n_train:n_train + n_val],
            "test": images[n_train + n_val:],
        }

        for split, files in split_files.items():
            for i, src in enumerate(files):
                dst = OUTPUT_DIR / split / cls / src.name
                if dst.exists():
                    dst = OUTPUT_DIR / split / cls / f"{i}_{src.name}"
                shutil.copy2(src, dst)

        summary[cls] = {s: len(v) for s, v in split_files.items()}

    split_df = pd.DataFrame(summary).T
    split_df.to_csv(RESULTS_DIR / "dataset_split_summary.csv")

    print("\nDATASET SPLIT")
    print(split_df)
    print("\nTotals:")
    print(split_df.sum())

    return summary


# ============================================================
# DATA LOADING / PREPROCESSING
# ============================================================

def build_datasets():
    def load(split, shuffle):
        return tf.keras.utils.image_dataset_from_directory(
            OUTPUT_DIR / split,
            labels="inferred",
            label_mode="categorical",
            class_names=CLASSES,
            image_size=IMG_SIZE,
            batch_size=BATCH_SIZE,
            shuffle=shuffle,
            seed=SEED,
        )

    train_raw = load("train", True)
    val_raw = load("val", False)
    test_raw = load("test", False)

    normalization = layers.Rescaling(1.0 / 255.0)

    augmentation = keras.Sequential(
        [
            layers.RandomRotation(0.08),
            layers.RandomFlip("horizontal"),
            layers.RandomZoom(0.10),
            layers.RandomTranslation(0.10, 0.10),
        ],
        name="training_augmentation",
    )

    def train_preprocess(x, y):
        return augmentation(normalization(x), training=True), y

    def eval_preprocess(x, y):
        return normalization(x), y

    train_ds = train_raw.map(train_preprocess, num_parallel_calls=AUTOTUNE)
    val_ds = val_raw.map(eval_preprocess, num_parallel_calls=AUTOTUNE)
    test_ds = test_raw.map(eval_preprocess, num_parallel_calls=AUTOTUNE)

    return (
        train_ds.prefetch(AUTOTUNE),
        val_ds.prefetch(AUTOTUNE),
        test_ds.prefetch(AUTOTUNE),
    )


# ============================================================
#  CBAM
# ============================================================

class CBAM(layers.Layer):
    def __init__(self, reduction_ratio=8, **kwargs):
        super().__init__(**kwargs)
        self.reduction_ratio = reduction_ratio

    def build(self, input_shape):
        channels = int(input_shape[-1])
        hidden = max(channels // self.reduction_ratio, 1)

        self.mlp = keras.Sequential(
            [
                layers.Dense(hidden, activation="relu"),
                layers.Dense(channels),
            ],
            name="channel_mlp",
        )

        self.spatial_conv = layers.Conv2D(
            1, kernel_size=7, padding="same", activation="sigmoid",
            use_bias=False, name="spatial_conv"
        )
        super().build(input_shape)

    def call(self, inputs):
        avg_pool = tf.reduce_mean(inputs, axis=[1, 2], keepdims=True)
        max_pool = tf.reduce_max(inputs, axis=[1, 2], keepdims=True)

        channel_attention = tf.nn.sigmoid(
            self.mlp(avg_pool) + self.mlp(max_pool)
        )
        x = inputs * channel_attention

        avg_spatial = tf.reduce_mean(x, axis=-1, keepdims=True)
        max_spatial = tf.reduce_max(x, axis=-1, keepdims=True)

        spatial_input = tf.concat([avg_spatial, max_spatial], axis=-1)
        spatial_attention = self.spatial_conv(spatial_input)

        return x * spatial_attention


# ============================================================
# MODEL BUILDERS
# ============================================================

def build_cnn_baseline():
    """Simple CNN baseline without EfficientNet, transfer learning, SSL or CBAM."""
    inputs = keras.Input(shape=(*IMG_SIZE, 3))

    x = layers.Conv2D(32, 3, padding="same", activation="relu")(inputs)
    x = layers.MaxPooling2D()(x)
    x = layers.Conv2D(64, 3, padding="same", activation="relu")(x)
    x = layers.MaxPooling2D()(x)
    x = layers.Conv2D(128, 3, padding="same", activation="relu")(x)
    x = layers.GlobalAveragePooling2D()(x)
    x = layers.Dropout(0.5)(x)
    outputs = layers.Dense(NUM_CLASSES, activation="softmax")(x)

    model = keras.Model(inputs, outputs, name="CNN_Baseline")
    compile_model(model)
    return model


def build_efficientnet(use_transfer=True, use_cbam=False, backbone_weights=None):
    if backbone_weights is None:
        backbone_weights = "imagenet" if use_transfer else None

    inputs = keras.Input(shape=(*IMG_SIZE, 3), name="input_image")

    backbone = tf.keras.applications.EfficientNetB0(
        include_top=False,
        weights=backbone_weights,
        input_tensor=inputs,
    )

    # Freeze only for ImageNet transfer learning.
    backbone.trainable = False if use_transfer else True

    x = backbone.output

    if use_cbam:
        x = CBAM(name="cbam")(x)

    x = layers.GlobalAveragePooling2D(name="global_average_pooling")(x)
    x = layers.Dropout(0.5)(x)
    outputs = layers.Dense(
        NUM_CLASSES, activation="softmax", name="classifier"
    )(x)

    name_parts = ["EfficientNetB0"]
    if use_transfer:
        name_parts.append("Transfer")
    else:
        name_parts.append("Scratch")
    if use_cbam:
        name_parts.append("CBAM")

    model = keras.Model(
        inputs, outputs, name="_".join(name_parts)
    )
    compile_model(model)
    return model


def compile_model(model):
    model.compile(
        optimizer=keras.optimizers.Adam(learning_rate=LEARNING_RATE),
        loss="categorical_crossentropy",
        metrics=[
            keras.metrics.CategoricalAccuracy(name="accuracy"),
        ],
    )


# ============================================================
#  CONTRASTIVE SSL
# ============================================================

class ProjectionHead(layers.Layer):
    def __init__(self, projection_dim=128):
        super().__init__()
        self.net = keras.Sequential(
            [
                layers.Dense(256, activation="relu"),
                layers.Dense(projection_dim),
            ]
        )

    def call(self, x):
        return tf.math.l2_normalize(self.net(x), axis=1)


def contrastive_loss(z1, z2, temperature=0.1):
    z1 = tf.math.l2_normalize(z1, axis=1)
    z2 = tf.math.l2_normalize(z2, axis=1)

    logits = tf.matmul(z1, z2, transpose_b=True) / temperature
    labels = tf.range(tf.shape(z1)[0])

    loss_1 = tf.keras.losses.sparse_categorical_crossentropy(
        labels, logits, from_logits=True
    )
    loss_2 = tf.keras.losses.sparse_categorical_crossentropy(
        labels, tf.transpose(logits), from_logits=True
    )

    return tf.reduce_mean((loss_1 + loss_2) / 2.0)


def ssl_augment(images):
    aug = keras.Sequential(
        [
            layers.RandomRotation(0.08),
            layers.RandomFlip("horizontal"),
            layers.RandomZoom(0.10),
            layers.RandomTranslation(0.10, 0.10),
        ]
    )
    return aug(images, training=True), aug(images, training=True)


def ssl_pretrain(train_ds, epochs=SSL_EPOCHS):
    """
    Contrastive SSL pretraining of EfficientNet-B0.
    The resulting encoder weights are transferred into the supervised
    EfficientNet model.
    """
    encoder = tf.keras.applications.EfficientNetB0(
        include_top=False,
        weights="imagenet",
        input_shape=(*IMG_SIZE, 3),
        pooling="avg",
    )
    projection = ProjectionHead(128)
    optimizer = keras.optimizers.Adam(learning_rate=LEARNING_RATE)

    for epoch in range(epochs):
        losses = []

        for images, _ in train_ds:
            view1, view2 = ssl_augment(images)

            with tf.GradientTape() as tape:
                h1 = encoder(view1, training=True)
                h2 = encoder(view2, training=True)
                z1 = projection(h1)
                z2 = projection(h2)
                loss = contrastive_loss(z1, z2)

            variables = encoder.trainable_variables + projection.trainable_variables
            grads = tape.gradient(loss, variables)
            optimizer.apply_gradients(zip(grads, variables))
            losses.append(float(loss))

        print(
            f"SSL epoch {epoch + 1}/{epochs}: "
            f"loss={np.mean(losses):.4f}"
        )

    return encoder


def build_ssl_supervised_model(ssl_encoder, use_cbam=False):
    """
    Build supervised model and initialize its EfficientNet backbone
    from the SSL-pretrained encoder.
    """
    inputs = keras.Input(shape=(*IMG_SIZE, 3), name="input_image")

    backbone = tf.keras.applications.EfficientNetB0(
        include_top=False,
        weights=None,
        input_tensor=inputs,
    )
    backbone.set_weights(ssl_encoder.get_weights())
    backbone.trainable = False

    x = backbone.output

    if use_cbam:
        x = CBAM(name="cbam")(x)

    x = layers.GlobalAveragePooling2D(name="global_average_pooling")(x)
    x = layers.Dropout(0.5)(x)
    outputs = layers.Dense(
        NUM_CLASSES, activation="softmax", name="classifier"
    )(x)

    name = "EfficientNetB0_SSL" + ("_CBAM" if use_cbam else "")
    model = keras.Model(inputs, outputs, name=name)
    compile_model(model)
    return model


# ============================================================
# TRAINING
# ============================================================

def train_one_model(model, train_ds, val_ds, model_key):
    checkpoint_path = RESULTS_DIR / f"{model_key}_best.keras"

    callbacks = [
        keras.callbacks.ModelCheckpoint(
            checkpoint_path,
            monitor="val_accuracy",
            save_best_only=True,
            mode="max",
        ),
        keras.callbacks.EarlyStopping(
            monitor="val_accuracy",
            patience=8,
            restore_best_weights=True,
            mode="max",
        ),
        keras.callbacks.ReduceLROnPlateau(
            monitor="val_loss",
            factor=0.5,
            patience=3,
            min_lr=1e-7,
        ),
    ]

    print(f"\n{'=' * 80}")
    print(f"TRAINING: {model_key}")
    print(f"{'=' * 80}")

    history = model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=EPOCHS,
        callbacks=callbacks,
        verbose=1,
    )

    model.save(RESULTS_DIR / f"{model_key}_final.keras")
    pd.DataFrame(history.history).to_csv(
        RESULTS_DIR / f"{model_key}_history.csv",
        index=False,
    )

    return model


# ============================================================
#  PREDICTION
# ============================================================

def collect_predictions(model, test_ds):
    y_true = []
    y_prob = []

    for images, labels in test_ds:
        probs = model.predict(images, verbose=0)
        y_prob.append(probs)
        y_true.append(labels.numpy())

    y_prob = np.concatenate(y_prob)
    y_true_onehot = np.concatenate(y_true)

    return np.argmax(y_true_onehot, axis=1), y_prob


# ============================================================
#  CONFUSION MATRIX
# ============================================================

def save_confusion_matrices(y_true, y_pred, model_key):
    cm = confusion_matrix(y_true, y_pred, labels=np.arange(NUM_CLASSES))

    # Raw counts
    plt.figure(figsize=(7, 6))
    sns.heatmap(
        cm,
        annot=True,
        fmt="d",
        cmap="Blues",
        xticklabels=CLASSES,
        yticklabels=CLASSES,
        cbar=False,
    )
    plt.xlabel("Predicted class")
    plt.ylabel("True class")
    plt.title(f"{model_key}: Confusion Matrix")
    plt.tight_layout()
    plt.savefig(
        RESULTS_DIR / f"{model_key}_confusion_matrix_counts.png",
        dpi=300,
        bbox_inches="tight",
    )
    plt.close()

    # Row-normalized percentages
    row_sums = cm.sum(axis=1, keepdims=True)
    cm_norm = np.divide(
        cm,
        row_sums,
        out=np.zeros_like(cm, dtype=float),
        where=row_sums != 0,
    )

    plt.figure(figsize=(7, 6))
    sns.heatmap(
        cm_norm * 100,
        annot=True,
        fmt=".1f",
        cmap="Blues",
        xticklabels=CLASSES,
        yticklabels=CLASSES,
        cbar=False,
    )
    plt.xlabel("Predicted class")
    plt.ylabel("True class")
    plt.title(f"{model_key}: Normalized Confusion Matrix (%)")
    plt.tight_layout()
    plt.savefig(
        RESULTS_DIR / f"{model_key}_confusion_matrix_normalized.png",
        dpi=300,
        bbox_inches="tight",
    )
    plt.close()

    return cm


# ============================================================
#  METRICS + 95% BOOTSTRAP CONFIDENCE INTERVALS
# ============================================================

def calculate_metrics(y_true, y_prob):
    y_pred = np.argmax(y_prob, axis=1)

    metrics = {
        "accuracy": accuracy_score(y_true, y_pred),
        "precision_macro": precision_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
        "recall_macro": recall_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
        "f1_macro": f1_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
    }

    try:
        y_true_onehot = np.eye(NUM_CLASSES)[y_true]
        metrics["auc_macro_ovr"] = roc_auc_score(
            y_true_onehot,
            y_prob,
            multi_class="ovr",
            average="macro",
        )
    except ValueError:
        metrics["auc_macro_ovr"] = np.nan

    return metrics

def bootstrap_confidence_intervals(
    y_true,
    y_prob,
    n_bootstrap=BOOTSTRAP_N,
    seed=SEED,
):
    """
    Non-parametric bootstrap 95% percentile confidence intervals.
    Resamples test predictions with replacement.
    """
    rng = np.random.default_rng(seed)
    n = len(y_true)

    point = calculate_metrics(y_true, y_prob)

    bootstrap_values = {k: [] for k in point}

    for _ in range(n_bootstrap):
        indices = rng.integers(0, n, size=n)

        bt_true = y_true[indices]
        bt_prob = y_prob[indices]

        values = calculate_metrics(bt_true, bt_prob)

        for key, value in values.items():
            if np.isfinite(value):
                bootstrap_values[key].append(value)

    output = {}

    for key, estimate in point.items():
        values = np.asarray(bootstrap_values[key], dtype=float)

        if len(values) == 0:
            low, high = np.nan, np.nan
        else:
            low, high = np.percentile(values, [2.5, 97.5])

        output[key] = {
            "estimate": estimate,
            "ci_low": low,
            "ci_high": high,
        }

    return output


def per_class_ci(y_true, y_prob, n_bootstrap=BOOTSTRAP_N, seed=SEED):
    """95% bootstrap CIs for sensitivity and specificity of each class."""
    y_pred = np.argmax(y_prob, axis=1)
    rng = np.random.default_rng(seed)
    n = len(y_true)

    records = []

    for class_idx, cls in enumerate(CLASSES):
        sens_values = []
        spec_values = []

        for _ in range(n_bootstrap):
            indices = rng.integers(0, n, size=n)
            yt = y_true[indices]
            yp = y_pred[indices]

            tp = np.sum((yt == class_idx) & (yp == class_idx))
            fn = np.sum((yt == class_idx) & (yp != class_idx))
            fp = np.sum((yt != class_idx) & (yp == class_idx))
            tn = np.sum((yt != class_idx) & (yp != class_idx))

            sens = tp / (tp + fn) if (tp + fn) else np.nan
            spec = tn / (tn + fp) if (tn + fp) else np.nan

            if np.isfinite(sens):
                sens_values.append(sens)
            if np.isfinite(spec):
                spec_values.append(spec)

        sens = np.mean((y_true == class_idx) == (y_pred == class_idx))

        sens_point = (
            np.sum((y_true == class_idx) & (y_pred == class_idx))
            / np.sum(y_true == class_idx)
        )
        spec_point = (
            np.sum((y_true != class_idx) & (y_pred != class_idx))
            / np.sum(y_true != class_idx)
        )

        records.append(
            {
                "class": cls,
                "sensitivity": sens_point,
                "sensitivity_ci_low": np.percentile(sens_values, 2.5),
                "sensitivity_ci_high": np.percentile(sens_values, 97.5),
                "specificity": spec_point,
                "specificity_ci_low": np.percentile(spec_values, 2.5),
                "specificity_ci_high": np.percentile(spec_values, 97.5),
            }
        )

    return pd.DataFrame(records)


def save_evaluation(y_true, y_prob, model_key):
    y_pred = np.argmax(y_prob, axis=1)

    # Classification report
    report = classification_report(
        y_true,
        y_pred,
        labels=np.arange(NUM_CLASSES),
        target_names=CLASSES,
        output_dict=True,
        zero_division=0,
    )
    pd.DataFrame(report).T.to_csv(
        RESULTS_DIR / f"{model_key}_classification_report.csv"
    )

    # Confusion matrices
    save_confusion_matrices(y_true, y_pred, model_key)

    # Overall bootstrap CIs
    ci = bootstrap_confidence_intervals(
        y_true,
        y_prob,
        n_bootstrap=BOOTSTRAP_N,
        seed=SEED,
    )

    rows = []
    for metric, values in ci.items():
        rows.append(
            {
                "model": model_key,
                "metric": metric,
                "estimate": values["estimate"],
                "95_CI_low": values["ci_low"],
                "95_CI_high": values["ci_high"],
            }
        )

    overall_df = pd.DataFrame(rows)
    overall_df.to_csv(
        RESULTS_DIR / f"{model_key}_metrics_95CI.csv",
        index=False,
    )

    # Per-class sensitivity/specificity CIs
    class_df = per_class_ci(
        y_true,
        y_prob,
        n_bootstrap=BOOTSTRAP_N,
        seed=SEED,
    )
    class_df.insert(0, "model", model_key)
    class_df.to_csv(
        RESULTS_DIR / f"{model_key}_per_class_95CI.csv",
        index=False,
    )

    print(f"\n{model_key} evaluation")
    for row in rows:
        print(
            f"{row['metric']:20s}: "
            f"{row['estimate']:.4f} "
            f"(95% CI {row['95_CI_low']:.4f}–{row['95_CI_high']:.4f})"
        )

    print("\nPer-class sensitivity/specificity:")
    print(class_df.to_string(index=False))

    return overall_df, class_df


# ============================================================
# ABLATION COMPARISON
# ============================================================

def build_ablation_models(train_ds):
    """
    Models isolate the contribution of each predictive component.

    CNN baseline
    EfficientNet-B0 without transfer
    EfficientNet-B0 + ImageNet transfer
    EfficientNet-B0 + transfer + SSL
    EfficientNet-B0 + transfer + CBAM
    EfficientNet-B0 + transfer + SSL + CBAM = proposed classifier

    Grad-CAM is applied after training and is not counted as a
    classification-performance component.
    """
    models = {}

    models["CNN_Baseline"] = build_cnn_baseline()

    models["EfficientNet_Scratch"] = build_efficientnet(
        use_transfer=False,
        use_cbam=False,
    )

    models["EfficientNet_Transfer"] = build_efficientnet(
        use_transfer=True,
        use_cbam=False,
    )

    models["EfficientNet_Transfer_CBAM"] = build_efficientnet(
        use_transfer=True,
        use_cbam=True,
    )

    print("\nStarting contrastive SSL pretraining...")
    ssl_encoder = ssl_pretrain(train_ds, epochs=SSL_EPOCHS)

    models["EfficientNet_Transfer_SSL"] = build_ssl_supervised_model(
        ssl_encoder,
        use_cbam=False,
    )

    models["Proposed_EfficientNet_SSL_CBAM"] = build_ssl_supervised_model(
        ssl_encoder,
        use_cbam=True,
    )

    return models


def run_ablation_study(train_ds, val_ds, test_ds):
    models = build_ablation_models(train_ds)

    all_metric_rows = []
    all_class_rows = []

    for model_key, model in models.items():
        model = train_one_model(
            model,
            train_ds,
            val_ds,
            model_key,
        )

        y_true, y_prob = collect_predictions(model, test_ds)

        overall_df, class_df = save_evaluation(
            y_true,
            y_prob,
            model_key,
        )

        all_metric_rows.append(overall_df)
